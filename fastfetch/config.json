{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-icat",
    "source": "~/.config/kitty/images/kitten.png",
    "width": 15,
    "height": 9,
    "printRemaining": true
  },
  "display": {
    "separator": "   ",
    "key": {
      "width": 12,
      "type": "both"
    }
  },
  "modules": [
    {
      "type": "os",
      "key": "OS",
      "format": "{version} {pretty-name}"
    },
    {
      "type": "host",
      "key": "Name",
      "format": "{name}"
    },
    {
      "type": "packages",
      "key": "Packages",
      "format": "{all}"
    },
    {
      "type": "shell",
      "key": "Shell",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "Emulator",
      "format": "{pretty-name}"
    },
    {
      "type": "command",
      "key": "Terminal",
      "shell": "bash",
      "text": "echo $TERM"
    },
    {
      "type": "disk",
      "key": "Disk (/)",
      "format": "{size-used} / {size-total} ({size-percentage})",
      "folders": "/"
    },
    {
      "type": "memory",
      "key": "RAM",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "localip",
      "key": "Local IP",
      "format": "{ipv4}",
      "showIpv4": true,
      "showIpv6": false
    },
    {
      "type": "battery",
      "key": "Battery",
      "format": "{capacity} ({status})"
    }
  ]
}

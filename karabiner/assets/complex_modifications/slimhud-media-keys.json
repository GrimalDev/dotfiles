{
  "title": "SlimHUD media keys",
  "rules": [
    {
      "description": "Direct volume and brightness keys for SlimHUD (no native HUD)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "consumer_key_code": "volume_increment",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "shell_command": "/bin/bash \"$HOME/.config/karabiner/scripts/media-key.sh\" press volume-up 0.0625"
            }
          ],
          "to_if_held_down": [
            {
              "shell_command": "/bin/bash \"$HOME/.config/karabiner/scripts/media-key.sh\" hold volume-up 0.0625"
            }
          ],
          "to_after_key_up": [
            {
              "shell_command": "/bin/bash \"$HOME/.config/karabiner/scripts/media-key.sh\" release volume-up"
            }
          ],
          "parameters": {
            "basic.to_if_held_down_threshold_milliseconds": 300
          }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "f12",
            "modifiers": {
              "optional": [
                "caps_lock"
              ]

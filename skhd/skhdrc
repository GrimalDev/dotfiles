# Control actions remaps
ctrl - j [
  "kitty" ~
  * : skhd -k 'down'
]
ctrl - k [
  "kitty" ~
  * : skhd -k 'up'
]

ctrl - m [
  "kitty" ~
  * : skhd -k 'return'
]
ctrl - a [
  "kitty" ~
  * : skhd -k 'cmd - a'
]
ctrl - c [
  "kitty" ~
  * : skhd -k 'cmd - c'
]
ctrl - v [
  "kitty" ~
  * : skhd -k 'cmd - v'
]
ctrl - z [
  "kitty" ~
  * : skhd -k 'cmd - z'
]
shift + ctrl - v : skhd -k 'cmd - v'
shift + ctrl - c : skhd -k 'shift + cmd - c'
ctrl - v [
  "kitty" ~
  * : skhd -k 'cmd - v'
]

# scroll up and down
alt - j [
  "kitty" ~
  "tabby" ~
  * : skhd -k 'pagedown'
]
alt - k [
  "kitty" ~
  * : skhd -k 'pageup'
]

# text manipulation controls
ctrl - w [
  "kitty" ~
  * : skhd -k 'alt - backspace'
]

# System control

shift + alt + cmd - l : /bin/bash -c "pmset sleepnow"


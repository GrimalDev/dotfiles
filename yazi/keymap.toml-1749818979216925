[[manager.prepend_keymap]]
on   = "l"
run  = "plugin smart-enter"
desc = "Enter the child directory, or open the file"

[[manager.prepend_keymap]]
on   = "i"
run  = "plugin max-preview"
desc = "Maximize or restore preview"

[[manager.prepend_keymap]]
on  = "M"
run = "plugin mount"

[[manager.prepend_keymap]]
on   = "F"
run  = "plugin smart-filter"
desc = "Smart filter"

[[manager.prepend_keymap]]
on   = "<C-j>"
run  = "arrow 1"
desc = "Smart filter"

[[manager.prepend_keymap]]
on   = [ "c", "m" ]
run  = "plugin chmod"
desc = "Chmod on selected files"

[[manager.prepend_keymap]]
on = [ ";", "w" ]
run = "cd ~/Code/Work/"
desc = "Work directory"

[[manager.prepend_keymap]]
on = [ ";", "s" ]
run = "cd ~/Code/Scolaire/"
desc = "School directory"

[[manager.prepend_keymap]]
on = [ ";", "c" ]
run = "cd ~/.config/"
desc = "Config directory"

[[manager.prepend_keymap]]
on = [ ";", "h" ]
run = "cd ~/"
desc = "Home directory"

[[manager.prepend_keymap]]
on = [ ";", "d" ]
run = "cd ~/Downloads"
desc = "Downloads"

[[manager.prepend_keymap]]
on = [ ";", "p" ]
run = "cd ~/Code/Projects/"
desc = "Code projects"

[[manager.prepend_keymap]]
on = "y"
run = [ '''shell 'fish -c "copy_file \"$@\""' ''', "yank" ]

[[manager.prepend_keymap]]
on = [ ";", "u" ]
run = "cd /Volumes"
desc = "Mounted volumes"

[[manager.prepend_keymap]]
on = [ "S" ]
run = '''shell 'fish -c "share \"$@\""' --confirm'''
desc = "Share file"

[[manager.prepend_keymap]]
on = [ "o" ]
run = '''shell 'fish -c "open \"$@\""' '''
desc = "Open file"

[[manager.prepend_keymap]]
on = [ "z" ]
run = '''shell 'fish -c "zathura \"$@\" & disown"' '''
desc = "Open PDF with Zathura"

[[manager.prepend_keymap]]
on = [ "s" ]
run = "plugin fzf"
desc = "Fuzzy search in current file"

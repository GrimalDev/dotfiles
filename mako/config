# GLOBAL
max-history=100
sort=-time

# BINDING OPTIONS
on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all
on-touch=dismiss
#on-notify=exec mpv /usr/share/sounds/freedesktop/stereo/message.oga

# STYLE OPTIONS
font=Jetbrainsmono Nerd Font 12
width=400
height=200
margin=10
padding=15
border-size=2
border-radius=10
icons=1
max-icon-size=48
icon-location=left
markup=1
actions=1
history=1
text-alignment=center
default-timeout=5000
ignore-timeout=0
max-visible=5
layer=overlay
anchor=top-right

background-color=#272E33
text-color=#D3C6AA
border-color=#D3C6AA
progress-color=over #7FBBB3

[urgency=low]
border-color=#859289
default-timeout=2000

[urgency=normal]
border-color=#D3C6AA
default-timeout=5000

[urgency=high]
border-color=#E67E80
text-color=#E67E80
default-timeout=0

[category=mpd]
border-color=#DBBC7F
default-timeout=2000
group-by=category

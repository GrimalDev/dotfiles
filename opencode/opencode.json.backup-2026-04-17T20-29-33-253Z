{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-openagent@latest"],
  "mcp": {
    "git-master": {
      "enabled": true
    },
    "mgrep": {
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "git add *": "deny",
      "git stage *": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "git reset *": "deny",
      "git rebase *": "deny",
      "git merge *": "deny",
      "git stash *": "deny",
      "git checkout *": "deny",
      "git switch *": "deny",
      "git restore *": "deny",
      "gh pr create *": "deny",
      "gh pr merge *": "deny",
      "gh pr close *": "deny",
      "gh pr comment *": "deny",
      "gh pr edit *": "deny",
      "gh issue create *": "deny",
      "gh issue close *": "deny",
      "gh issue comment *": "deny",
      "gh issue edit *": "deny",
      "gh release create *": "deny",
      "gh repo create *": "deny",
      "gh repo delete *": "deny",
      "mysql *": "deny",
      "mariadb *": "deny",
      "sqlite *": "deny",
      "rm *": "deny"
    }
  }
}
